// GENERATED by File -> Build Settings -> Player Settings -> Android -> Publishing Settings -> Custom Main Gradle Template
// 사용 활성화: Player Settings > Android > Publishing Settings > Custom Main Gradle Template 체크
//
// AdMob / Firebase / Google Play Services 의존성을 수동으로 관리. External Dependency Manager 가
// 설치돼 있으면 이 파일 대신 XML(Editor/GoogleServicesDependencies.xml 등)로도 관리 가능.
//
// 버전은 소프트런칭 직전 최신으로 bump 권장.

apply plugin: 'com.android.library'
**APPLY_PLUGINS**

dependencies {
    implementation fileTree(dir: 'libs', include: ['*.jar'])
**DEPS**

    // unityLibrary 은 자기 자신이므로 project(':unityLibrary') 금지.

    // Google Play Services (AdMob 의존)

    // Play Billing (Unity IAP 내부에서 사용)

    // Firebase (BOM 으로 버전 일괄 관리)
    // 주석 해제는 google-services.json 배치 + google-services 플러그인 적용 후.
    // implementation platform('com.google.firebase:firebase-bom:33.4.0')
    // implementation 'com.google.firebase:firebase-analytics'
    // implementation 'com.google.firebase:firebase-crashlytics'
}

android {
    ndkPath "**NDKPATH**"

    compileSdkVersion **APIVERSION**
    buildToolsVersion '**BUILDTOOLS**'

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_11
        targetCompatibility JavaVersion.VERSION_11
    }

    defaultConfig {
        minSdkVersion **MINSDKVERSION**
        targetSdkVersion **TARGETSDKVERSION**
        ndk {
            abiFilters **ABIFILTERS**
        }
        versionCode **VERSIONCODE**
        versionName '**VERSIONNAME**'
        consumerProguardFiles 'proguard-unity.txt'**USER_PROGUARD**
    }

    lint {
        abortOnError false
    }

    androidResources {
        noCompress = **BUILTIN_NOCOMPRESS** + unityStreamingAssets.tokenize(', ')
        ignoreAssetsPattern = "!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~"
    }**PACKAGING_OPTIONS**
}
**IL_CPP_BUILD_SETUP**
**SOURCE_BUILD_SETUP**
**EXTERNAL_SOURCES**
